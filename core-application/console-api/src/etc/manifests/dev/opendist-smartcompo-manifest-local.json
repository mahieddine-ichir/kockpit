{
  "domain": "opendist",
  "env": "local",
  "applications": [
    {
      "id": "smartcompo",
      "label": "OpenDist SmartCompo",
      "subDomain": "opendist",
      "services": {
        "audit": [
          {
            "name": "smartcompo",
            "label": "Smart Compo",
            "appIds": [
              "smartcompo"
            ],
            "resultColumns": [
              {
                "name": "start",
                "label": "Start",
                "renderer": "date"
              },
              {
                "name": "traceId",
                "label": "Trace ID",
                "renderer": "substring"
              },
              {
                "name": "KResult",
                "label": "K Result",
                "renderer": "result"
              },
              {
                "name": "origin",
                "label": "Origin"
              },
              {
                "name": "hotelCode",
                "label": "Hotel Code"
              },
              {
                "name": "httpMethod",
                "label": "Method"
              },
              {
                "name": "requestUri",
                "label": "Url"
              },
              {
                "name": "httpStatus",
                "label": "Status",
                "renderer": "status"
              }
            ],
            "searchMetadatas": [
              {
                "name": "origin",
                "label": "Origin",
                "description": "Origin",
                "type": "extension",
                "subtype": "builtin.kv"
              },
              {
                "name": "httpMethod",
                "label": "HTTP Method",
                "description": "Method",
                "type": "extension",
                "subtype": "builtin.kv"
              },
              {
                "name": "httpStatus",
                "label": "Status",
                "description": "Request HTTP Status",
                "type": "extension",
                "subtype": "builtin.kv"
              },
              {
                "name": "traceId",
                "label": "Trace ID",
                "description": "Trace ID",
                "type": "extension",
                "subtype": "builtin.kv"
              }
            ]
          }
        ]
      }
    }
  ]
}
