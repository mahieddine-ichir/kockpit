    {
      "id": "wcxss-sbk",
      "label": "StayBooking",
      "subDomain": "fnb",
      "services": {
        "sqsdlq": [
          {
            "name": "sqs-sbk",
            "label": "Staybooking dlq",
            "dlq": "sqs-sbk-dlq",
            "dlqArn": "sqs-sbk-dlq",
            "url": "http://localhost:4566/queue/sqs-sbk",
            "concurrentConsumers": 20,
            "deleteWhenReplay": true,
            "resultColumns": [
              {
                "name"  : "pmid",
                "label" : "PMID"
              },
              {
                "name"  : "survivor",
                "label" : "Survivor"
              },
              {
                "name"  : "victim",
                "label" : "Victim"
              },
              {
                "name"  : "service",
                "label" : "Service"
              },
              {
                "name"  : "legacyHttpStatusCode",
                "label" : "Legacy http status code"
              },
              {
                "name"  : "origin",
                "label" : "Origin"
              },
              {
                "name"  : "writetime",
                "label" : "Writetime"
              },
              {
                "name"  : "errorDescription",
                "label" : "Error description"
              }
            ]

          }
        ]
      }
    },
