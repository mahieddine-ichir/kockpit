# Real Azure Storage Account configuration.
# Without a .env file, the stack uses the local Azurite emulator.
# To use a real storage account instead: cp .env.azure .env, then fill in the keys.

# Format: https://<your-storage-account-name>.blob.core.windows.net
STORAGE_ENDPOINT=https://kockpitreferentialdev.blob.core.windows.net
STORAGE_ACCOUNT=kockpitreferentialdev
STORAGE_KEY=<your-azure-storage-key>
STORAGE_CONTAINER=referentialdev

# manifests config
MANIFESTS_STORAGE_ENDPOINT=https://kockpitreferentialdev.blob.core.windows.net
MANIFESTS_STORAGE_ACCOUNT=kockpitreferentialdev
MANIFESTS_STORAGE_KEY=<your-azure-storage-key>
MANIFESTS_STORAGE_CONTAINER=manifestsdev
