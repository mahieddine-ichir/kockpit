<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.11</version>
	</parent>
	<groupId>org.kockpit</groupId>
	<artifactId>kockpit</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>__ Kockpit</name>
	<description>Kockpit Engineering Platform</description>
	<url>https://github.com/mahieddine-ichir/kockpit</url>

	<licenses>
		<license>
			<name>Apache License, Version 2.0</name>
			<url>https://www.apache.org/licenses/LICENSE-2.0</url>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<developers>
		<developer>
			<id>mahieddine-ichir</id>
			<name>Mahieddine Ichir</name>
			<email>mahieddine.ichir@gmail.com</email>
			<url>https://github.com/mahieddine-ichir/kockpit</url>
		</developer>
		<developer>
			<id>cyril-joui</id>
			<name>Cyril Joui</name>
			<email>cyril@kisstech.fr</email>
			<url>https://github.com/mahieddine-ichir/kockpit</url>
		</developer>
	</developers>

	<scm>
		<connection>scm:git:https://github.com/mahieddine-ichir/kockpit.git</connection>
		<developerConnection>scm:git:ssh://git@github.com/mahieddine-ichir/kockpit.git</developerConnection>
		<url>https://github.com/mahieddine-ichir/kockpit</url>
		<tag>kockpit-1.0.1-beta</tag>
	</scm>

	<properties>
		<java.version>17</java.version>
		<lombok.version>1.18.42</lombok.version>
	</properties>
	<modules>
        <module>kockpit-libs</module>
		<module>kockpit-rules</module>
        <module>kockpit-core</module>
		<module>kockpit-audit</module>
        <module>kockpit-core-applications</module>
        <module>kockpit-features</module>
		<module>kockpit-backends</module>
		<module>kockpit-ai</module>
        <module>kockpit-samples</module>
        <module>kockpit-core/kockpit-core-communication-legacy</module>
    </modules>

	<profiles>
		<profile>
			<id>central</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.sonatype.central</groupId>
						<artifactId>central-publishing-maven-plugin</artifactId>
						<version>0.9.0</version>
						<extensions>true</extensions>
						<configuration>
							<publishingServerId>central</publishingServerId>
						</configuration>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-source-plugin</artifactId>
						<version>3.3.0</version>
						<executions>
							<execution>
								<id>attach-sources</id>
								<phase>verify</phase>
								<goals>
									<goal>jar-no-fork</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-javadoc-plugin</artifactId>
						<version>3.6.3</version>
						<executions>
							<execution>
								<id>attach-javadoc</id>
								<goals>
									<goal>jar</goal>
								</goals>
							</execution>
						</executions>
						<configuration>
							<stylesheet>java</stylesheet>
							<doclint>none</doclint>
							<additionalOptions>-package</additionalOptions>
						</configuration>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-gpg-plugin</artifactId>
						<version>3.2.6</version>
						<executions>
							<execution>
								<id>sign-artifacts</id>
								<phase>verify</phase>
								<goals>
									<goal>sign</goal>
								</goals>
							</execution>
						</executions>
						<configuration>
							<gpgArguments>
								<arg>--pinentry-mode</arg>
								<arg>loopback</arg>
							</gpgArguments>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
