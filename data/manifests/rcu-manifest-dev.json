  {
    "domain": "rcu",
    "env": "dev",
    "services": [
      {
        "name": "RCU Audits",
        "type": "audit",
        "id": "audit",
        "config": {
          "columns": [
            "appId", "requestId", "method", "path", "gbid", "start", "duration", "status"
          ],
          "search_columns": [
            {
              "name": "appId",
              "type": "options",
              "options": [
                "orchestrator",
                "rcu-api",
                "rcu-migration",
                "rcu-inbox"
              ]
            },
            {
              "name": "gbid",
              "type": "number",
              "path": "indexedKeyValues.gbid"
            },
            {
              "name": "rowId"
            },
            {
              "name": "httpStatus",
              "type": "options",
              "options": [200, 201, 400, 404, 401, 500],
              "path": "indexedKeyValues.httpStatus"
            },
            {
              "name": "httpMethod",
              "type": "options",
              "options": ["GET", "POST", "PUT", "DELETE", "inbox:event"],
              "path": "indexedKeyValues.httpMethod"
            }
          ],
          "saved_filters": [
            {
              "name": "500 / POST|PUT",
              "filters": [
                {
                  "name": "POST / PUT",
                  "path": "indexedKeyValues.httpMethod",
                  "values": [ "POST", "PUT" ]
                },
                {
                  "name": "4xx / 5xx",
                  "path": "indexedKeyValues.httpStatus",
                  "values": [ 400, 401, 404, 500 ]
                }
              ]
            },
            {
              "name": "POST/PUT",
              "filters": [
                {
                  "name": "httpMethod",
                  "path": "indexedKeyValues.httpMethod",
                  "values": [ "POST", "PUT" ]
                }
              ]
            },
            {
              "name": "4xx / 5xx",
              "filters": [
                {
                  "name": "httpStatus",
                  "path": "indexedKeyValues.httpStatus",
                  "values": [ 400, 401, 404, 500 ]
                }
              ]
            }
          ]
        }
      }
    ]
  }
