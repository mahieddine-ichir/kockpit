[
  {
    "domain": "rcu",
    "env": "oat",
    "policies": [
      {
        "groups": [
          "rcu-fid"
        ],
        "permissions": [
          "audit:*",
          "feature-flipping:refresh"
        ],
        "resources": []
      },
      {
        "groups": [
          "rcu-fid-mco"
        ],
        "permissions": [
          "audit:read"
        ],
        "resources": [
          "audit:rcu-audit"
        ]
      }
    ],
    "services": [
      {
        "type": "audit",
        "id": "rcu-audit",
        "name": "RCU Audit",
        "config": {
          "columns": [
            "appId",
            "requestId",
            "method",
            "path",
            "gbid",
            "start",
            "duration",
            "status"
          ],
          "search_columns": [
            {
              "name": "appId",
              "type": "options",
              "options": [
                "orchestrator",
                "rcu-api",
                "rcu-migration",
                "rcu-support-api"
              ]
            },
            {
              "name": "gbid",
              "type": "number",
              "path": "audits.events.httpAuditedResponse.body"
            },
            {
              "name": "rowId"
            },
            {
              "name": "httpStatus",
              "type": "options",
              "options": [200, 201, 400, 500],
              "path": "indexedKeyValues.httpStatus"
            },
            {
              "name": "httpMethod",
              "type": "options",
              "options": ["GET", "POST", "PUT"],
              "path": "indexedKeyValues.httpMethod"
            }
          ]
        }
      }
    ]
  }
]
