[
  {
    "domain" : "rcu",
    "env" : "pro",
    "services" : [
      {
        "name" : "audit",
        "config" : {
          "columns" : [ "appId", "requestId", "method", "path", "duration", "start", "status" ],
          "search_columns": [
            {
              "name": "appId",
              "type": "options",
              "options": [
                "orchestrator",
                "rcu-api"
              ]
            },
            {
              "name": "start",
              "type": "date",
              "path": "."
            },
            {
              "name": "end",
              "type": "date",
              "path": "."
            },
            {
              "name": "gbid",
              "type": "number",
              "path": "audits.events.httpAuditedResponse.body"
            },
            {
              "name": "rowId"
            },
            {
              "name": "httpStatus",
              "type": "options",
              "options": [200, 201, 400, 500],
              "path": "indexedKeyValues.httpStatus"
            },
            {
              "name": "httpMethod",
              "type": "options",
              "options": ["GET", "POST"],
              "path": "indexedKeyValues.httpMethod"
            }
          ],
          "saved_filters": [
            {
              "name": "rcu-api, Create en erreur",
              "filters": [
                {
                  "name": "appId",
                  "values": [ "rcu-api" ]
                },
                {
                  "name": "method",
                  "path": "indexedKeyValues.httpMethod",
                  "values": [ "POST", "PUT" ]
                },
                {
                  "name": "status",
                  "path": "indexedKeyValues.httpStatus",
                  "values": [ 400, 401, 404, 500 ]
                }
              ]
            },
            {
              "name": "rcu-api, Création OK",
              "filters": [
                {
                  "name": "appId",
                  "values": [ "rcu-api" ]
                },
                {
                  "name": "method",
                  "path": "indexedKeyValues.httpMethod",
                  "values": [ "POST" ]
                },
                {
                  "name": "status",
                  "path": "indexedKeyValues.httpStatus",
                  "values": [ 200, 201 ]
                }
              ]
            }
          ]
        }
      },
      {
        "name" : "feature-flipping",
        "config" : {
          "keys": [
            {
              "key" : "ff.darkcanary.enabled",
              "enabled" : false,
              "comment" : "Enable dark canary",
              "expiration" : "2025-10-07"
            },
            {
              "key" : "ff.payment.beta.enabled",
              "enabled" : true,
              "comment" : "enable payment (beta version)",
              "expiration" : "2025-10-01"
            },
            {
              "key" : "ff.aiassistant.enabled",
              "enabled" : true,
              "comment" : "Key without expiration",
              "expiration" : null
            }
          ]
        }
      }
    ]
  }
]
