[
  {
    "domain" : "rcu",
    "env" : "local",
    "services" : [
      {
        "name" : "RCU Audits",
        "type": "audit",
        "id": "audit-local",
        "config" : {
          "columns" : [ "appId", "requestId", "method", "path", "duration", "start", "status" ],
          "search_columns" : [ ],
          "saved_filters": [
            {
              "name": "rcu-api, Create en erreur",
              "filters": [
                {
                  "path": "appId",
                  "values": [ "rcu-api" ]
                },
                {
                  "name": "method",
                  "path": "indexedKeyValues.httpMethod",
                  "values": [ "POST", "PUT" ]
                },
                {
                  "name": "status",
                  "path": "indexedKeyValues.httpStatus",
                  "values": [ 400, 401, 404, 500 ]
                }
              ]
            },
            {
              "name": "rcu-api, OK",
              "filters": [
                {
                  "name": "appId",
                  "values": [ "rcu-api" ]
                },
                {
                  "name": "method",
                  "path": "indexedKeyValues.httpMethod",
                  "values": [ "POST" ]
                },
                {
                  "name": "status",
                  "path": "indexedKeyValues.httpStatus",
                  "values": [ 200, 201 ]
                }
              ]
            }
          ]
        }
      },
      {
        "id": "sample-app",
        "type": "feature-flipping",
        "name": "Sample App",
        "config": {
          "keys": [
            {
              "key": "solace.publish.enable",
              "enabled": true
            }
          ]
        }
      },
      {
        "id": "default",
        "type": "dyna-config",
        "name": "RCU",
        "config": {
          "keys": [
            {
              "key": "migration.pattern",
              "value": "[s-z]",
              "description": "Pattern de migration des comptes"
            },
            {
              "key": "key2.boolean",
              "value": false,
              "description": "Boolean value"
            }
          ]
        }
      },
      {
        "id": "default2",
        "type": "dyna-config",
        "name": "Sample App",
        "config": {
          "keys": [
            {
              "key": "any.key",
              "value": "any value",
              "description": "Demo value"
            }
          ]
        }
      }
    ]
  }
]
