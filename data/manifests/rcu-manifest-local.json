{
  "domain": "rcu",
  "env": "local",
  "name": "rcu-manifest-local.json",
  "services": [
    {
      "type": "audit",
      "name": "RCU Audits",
      "id": "audit-local",
      "config": {
        "columns": [
          "appId",
          "requestId",
          "method",
          "path",
          "duration",
          "start",
          "status"
        ],
        "search_columns": [],
        "saved_filters": [
          {
            "name": "rcu-api, Create en erreur",
            "filters": [
              {
                "path": "appId",
                "values": [
                  "rcu-api"
                ]
              },
              {
                "name": "method",
                "path": "indexedKeyValues.httpMethod",
                "values": [
                  "POST",
                  "PUT"
                ]
              },
              {
                "name": "status",
                "path": "indexedKeyValues.httpStatus",
                "values": [
                  400,
                  401,
                  404,
                  500
                ]
              }
            ]
          },
          {
            "name": "rcu-api, OK",
            "filters": [
              {
                "name": "appId",
                "values": [
                  "rcu-api"
                ]
              },
              {
                "name": "method",
                "path": "indexedKeyValues.httpMethod",
                "values": [
                  "POST"
                ]
              },
              {
                "name": "status",
                "path": "indexedKeyValues.httpStatus",
                "values": [
                  200,
                  201
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "type": "feature-flipping",
      "name": "Sample App",
      "id": "sample-app",
      "config": {
        "keys": [
          {
            "key": "solace.publish.enable",
            "enabled": true,
            "expirationDate": "2026-01-01",
            "comment": "Any comment/description of this flag"
          }
        ]
      }
    },
    {
      "type": "dyna-config",
      "name": "RCU",
      "id": "default",
      "config": {
        "keys": [
          {
            "key": "migration.pattern",
            "value": "[s-z]",
            "description": "Pattern de migration des comptes"
          },
          {
            "key": "key2.boolean",
            "value": false,
            "description": "Boolean value"
          }
        ]
      }
    },
    {
      "type": "dyna-config",
      "name": "Sample App",
      "id": "default2",
      "config": {
        "keys": [
          {
            "key": "any.key",
            "value": "any value",
            "description": "Demo value"
          }
        ]
      }
    }
  ]
}
