{
  "name": "kockpit-console-backend",
  "image": "ghcr.io/mahieddine-ichir/kockpit/kockpit-backend-application-aws:20260209-1513",
  "cpu": 0,
  "portMappings": [
    {
      "name": "kockpit-console-backend-8080-tcp",
      "containerPort": 8080,
      "hostPort": 8080,
      "protocol": "tcp",
      "appProtocol": "http"
    }
  ],
  "essential": true,
  "environment": [
    {
      "name": "KOCKPIT_AWS_REGION",
      "value": "eu-west-1"
    },
    {
      "name": "KOCKPIT_SDK_AWS_REGION",
      "value": "eu-west-1"
    },
    {
      "name": "OPENSEARCH_ENDPOINTS",
      "value": "vpc-wcp-dev-opk-domain-2gthk7dt74i6g7nzmtaxdpzhuu.eu-west-1.es.amazonaws.com"
    },
    {
      "name": "kockpit.audit.stream.opensearch.endpoints",
      "value": "vpc-wcp-dev-opk-domain-2gthk7dt74i6g7nzmtaxdpzhuu.eu-west-1.es.amazonaws.com"
    },
    {
      "name": "aws.region",
      "value": "eu-west-1"
    },
    {
      "name": "KOCKPIT_ENV",
      "value": "dev"
    },
    {
      "name": "kockpit.aws.s3.bucket",
      "value": "kockpit-data-dev"
    },
    {
      "name": "SPRING_PROFILES_ACTIVE",
      "value": "aws"
    },
    {
      "name": "kockpit.audit.notification.kinesis.stream_name",
      "value": "auditstream-dev"
    },
    {
      "name": "kockpit.manifests.aws.s3.bucket",
      "value": "kockpit-manifests-dev"
    },
    {
      "name": "kockpit.manifests.aws.region",
      "value": "eu-west-1"
    }
  ],
  "environmentFiles": [],
  "mountPoints": [],
  "volumesFrom": [],
  "ulimits": [],
  "logConfiguration": {
    "logDriver": "awslogs",
    "options": {
      "awslogs-group": "/ecs/kockpit-console-backend",
      "awslogs-create-group": "true",
      "awslogs-region": "eu-west-1",
      "awslogs-stream-prefix": "ecs"
    },
    "secretOptions": []
  },
  "systemControls": []
}
