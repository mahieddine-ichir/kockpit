# Copy this file to terraform.tfvars and update with your values

# AWS Configuration
aws_region = "eu-west-1"
environment = "production"  # or "dev", "staging"

# Existing Infrastructure
vpc_id = "vpc-0123456789abcdef0"
private_subnet_names = [
  "my-private-subnet-1a",
  "my-private-subnet-1b"
]
ecs_cluster_name = "my-production-cluster"
load_balancer_arn = "arn:aws:elasticloadbalancing:eu-west-1:123456789012:loadbalancer/app/my-prod-alb/1234567890123456"

# S3 Configuration
s3_bucket_name = "kockpit-data-prod"  # For IAM permissions

# Kockpit Configuration
opensearch_endpoints = "vpc-prod-search-xyz.eu-west-1.es.amazonaws.com"
kockpit_data_s3_bucket = "kockpit-data-prod"
kockpit_manifests_s3_bucket = "kockpit-manifests-prod"
kinesis_stream_name = "kockpit-audit-prod"

# Container Configuration
container_image = "ghcr.io/mahieddine-ichir/kockpit/kockpit-backend-application-aws:20260209-1513"
cpu = 1024
memory = 2048
desired_count = 3

# Load Balancer (Optional)
create_listener_rule = true
load_balancer_listener_arn = "arn:aws:elasticloadbalancing:eu-west-1:123456789012:listener/app/my-prod-alb/1234567890123456/0987654321098765"
listener_rule_priority = 100

# Additional Environment Variables (if needed)
additional_env_vars = [
  {
    name  = "LOG_LEVEL"
    value = "INFO"
  },
  {
    name  = "CUSTOM_CONFIG"
    value = "production-value"
  }
]

# Tags
tags = {
  Environment = "production"
  Project     = "my-company-kockpit"
  Team        = "platform"
  ManagedBy   = "terraform"
}