{
  "size": 0,
  "query": { "range": { "start": { "gte": "--gte--" } } },
  "aggs": {
    "by_app": {
      "terms": { "field": "appId", "size": 10 },
      "aggs": {
        "http_status_nested": {
          "nested": { "path": "--kv--" },
          "aggs": {
            "filter_status": {
              "filter": { "term": { "--kv--.key": "httpStatus" } },
              "aggs": {
                "status_groups": {
                  "filters": {
                    "filters": {
                      "2xx": { "range": { "--kv--.valueInteger": { "gte": 200, "lt": 300 } } },
                      "3xx": { "range": { "--kv--.valueInteger": { "gte": 300, "lt": 400 } } },
                      "4xx": { "range": { "--kv--.valueInteger": { "gte": 400, "lt": 500 } } },
                      "5xx": { "range": { "--kv--.valueInteger": { "gte": 500, "lt": 600 } } }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
