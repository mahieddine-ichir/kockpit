{
  "size": 0,
  "query": {
    "range": {
      "start": {
        "gte": "--gte--"
      }
    }
  },
  "aggs": {
    "by_app": {
      "terms": {
        "field": "appId",
        "size": 10
      },
      "aggs": {
        "avg_duration": {
          "nested": {
            "path": "--kv--"
          },
          "aggs": {
            "filter_duration": {
              "filter": {
                "term": {
                  "--kv--.key": "duration"
                }
              },
              "aggs": {
                "avg_value": {
                  "avg": {
                    "field": "--kv--.valueInteger"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
