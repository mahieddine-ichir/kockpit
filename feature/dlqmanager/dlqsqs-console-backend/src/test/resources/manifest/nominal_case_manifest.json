{
  "domain": "wcxss",
  "env": "local",
  "groups": [
    "XSS",
    "WCC"
  ],
  "applications": [
    {
      "id": "wcxss-insurance-purchase",
      "label": "Insurance Purchase",
      "services": {
        "sqsdlq": [
          {
            "name": "booking-event-notif.fifo",
            "label": "Booking Event Notif",
            "dlq": "booking-event-notif-dlq.fifo",
            "dlqArn": "booking-event-notif-dlq.fifo",
            "url": "http://localhost:4566/queue/booking-event-notif.fifo",
            "resultColumns": [
              {
                "name": "groupId",
                "label": "Group id"
              },
              {
                "name": "X-Wcp-TraceId",
                "label": "Trace Id"
              },
              {
                "name": "eventType",
                "label": "Event type"
              },
              {
                "name": "bookingSystem",
                "label": "Booking system"
              },
              {
                "name": "orderId",
                "label": "Order"
              },
              {
                "name": "orderItemId",
                "label": "Order item"
              }
            ]
          },
          {
            "name": "insurance-cancellation-notif",
            "label": "Cancellation Notif",
            "dlq": "insurance-cancellation-notif-dlq",
            "dlqArn": "insurance-cancellation-notif-dlq",
            "url": "http://localhost:4566/queue/insurance-cancellation-notif",
            "resultColumns": [
              {
                "name": "purchasedOfferId",
                "label": "Purchased offer"
              },
              {
                "name": "result.cancelCode",
                "label": "Cancel code"
              },
              {
                "name": "result.result",
                "label": "Result"
              }
            ]
          },
          {
            "name": "insurance-payment-status-update",
            "label": "Payment Status Update",
            "dlq": "insurance-payment-status-update-dlq",
            "dlqArn": "insurance-payment-status-update-dlq",
            "url": "http://localhost:4566/queue/insurance-payment-status-update",
            "resultColumns": [
              {
                "name": "purchasedOfferId",
                "label": "Purchased offer"
              },
              {
                "name": "targetStatus",
                "label": "Target status"
              },
              {
                "name": "pspTransactionId",
                "label": "Psp transaction"
              },
              {
                "name": "paymentAmount",
                "label": "Payment amount"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "wcpsamples",
      "label": "Samples",
      "services": {
        "sqsdlq": [
          {
            "name": "wcp-samples-sqsdlq-local",
            "label": "WCP Samples sqsdlq",
            "dlq": "wcp-samples-sqsdlq-local",
            "dlqArn": "wcp-samples-sqsdlq-local",
            "url": "http://localhost:4566/queue/wcp-samples-sqsdlq-local",
            "resultColumns": [
              {
                "name": "service",
                "label": "Service"
              },
              {
                "name": "test",
                "label": "Test"
              },
              {
                "name": "error",
                "label": "Error"
              }
            ]
          }
        ]
      }
    }
  ]
}
