  </parent>

  <artifactId>sample-app</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  <name>Kockpit Platform Engineering - Sample - Rest App with KEngine and Audit</name>

  <properties>
      <start-class>com.accor.wcp.sample.WcpSampleApplicationApp</start-class>
      <openapi-generator-maven-plugin.version>7.10.0</openapi-generator-maven-plugin.version>
      <swagger-annotations-v3.version>2.2.27</swagger-annotations-v3.version>
  </properties>

  <dependencies>
      <dependency>
          <groupId>org.kockpit</groupId>
          <artifactId>starter-full-web</artifactId>
          <version>${project.version}</version>
      </dependency>
      <dependency>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-cache</artifactId>
      </dependency>
      <dependency>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-actuator</artifactId>
      </dependency>
      <dependency>
          <groupId>org.springframework</groupId>
          <artifactId>spring-webflux</artifactId>
      </dependency>
      <dependency>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-security</artifactId>
      </dependency>
      <dependency>
          <groupId>io.opentelemetry</groupId>
          <artifactId>opentelemetry-api</artifactId>
      </dependency>
      <dependency>
          <groupId>io.swagger.core.v3</groupId>
          <artifactId>swagger-annotations</artifactId>
          <version>${swagger-annotations-v3.version}</version>
      </dependency>
      <dependency>
          <groupId>io.swagger.core.v3</groupId>
          <artifactId>swagger-models</artifactId>
          <version>${swagger-annotations-v3.version}</version>
      </dependency>

    <dependency>
      <groupId>org.hibernate.validator</groupId>
      <artifactId>hibernate-validator</artifactId>
    </dependency>

    <dependency>
      <groupId>org.kockpit</groupId>
      <artifactId>dynacache-application</artifactId>
        <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.ehcache</groupId>
      <artifactId>ehcache</artifactId>
    </dependency>

<!--    <dependency>-->
<!--        <groupId>org.kockpit</groupId>-->
<!--      <artifactId>wcp-rest-api-config-squiggly</artifactId>-->
<!--      <version>${project.version}</version>-->
<!--    </dependency>-->
    <dependency>
        <groupId>org.kockpit</groupId>
      <artifactId>rest-api-handler-problem</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
        <groupId>org.kockpit</groupId>
      <artifactId>rest-api-validation-acceptversion</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
        <groupId>org.kockpit</groupId>
      <artifactId>rest-api-filter-traceid</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
        <groupId>org.kockpit</groupId>
      <artifactId>rest-api-filter-contentlanguage</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
        <groupId>org.kockpit</groupId>
      <artifactId>rest-api-config-localeresolver</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
        <groupId>org.kockpit</groupId>
      <artifactId>audit-module-autoconfigure-kafka</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka-test</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.avro</groupId>
      <artifactId>avro</artifactId>
    </dependency>
    <dependency>
      <groupId>io.confluent</groupId>
      <artifactId>kafka-avro-serializer</artifactId>
      <exclusions>
        <exclusion>
          <groupId>org.apache.zookeeper</groupId>
          <artifactId>zookeeper</artifactId>
