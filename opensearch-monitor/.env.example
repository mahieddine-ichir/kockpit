PORT=3000

# Base URL of the OpenSearch cluster to monitor.
OPENSEARCH_URL=http://localhost:9200

# Optional basic auth, only sent if OPENSEARCH_USER is set.
# OPENSEARCH_USER=admin
# OPENSEARCH_PASSWORD=changeme

# Optional path prefix, only needed if this app is mounted under a subpath
# behind a shared reverse proxy/ALB (e.g. an ALB path-pattern rule) that
# forwards the full original path unchanged. Leave unset if the app owns the
# domain root. Example: BASE_PATH=/opensearch-monitor
# BASE_PATH=
