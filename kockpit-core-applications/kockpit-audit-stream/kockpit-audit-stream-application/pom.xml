<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.kockpit</groupId>
        <artifactId>kockpit-audit-stream</artifactId><version>1.2.0-SNAPSHOT</version>
    </parent>
    <artifactId>kockpit-audit-stream-application</artifactId>
    <name>Kockpit Audit Stream Application</name>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.kockpit</groupId>
            <artifactId>kockpit-audit-stream-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>1.6.3</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.opensearch.client</groupId>
            <artifactId>opensearch-java</artifactId>
            <version>3.9.0</version>
        </dependency>
        <dependency>
            <groupId>org.apache.httpcomponents.client5</groupId>
            <artifactId>httpclient5</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.httpcomponents.core5</groupId>
            <artifactId>httpcore5</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.httpcomponents.core5</groupId>
            <artifactId>httpcore5-h2</artifactId>
        </dependency>
        <dependency>
            <groupId>org.kockpit</groupId>
            <artifactId>kockpit-audit-api</artifactId>
            <version>1.2.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.kockpit</groupId>
            <artifactId>kockpit-features-audit-module-web</artifactId>
            <version>1.2.0-SNAPSHOT</version>
        </dependency>
        <!-- Jackson 3 (mappers locaux construits via JsonMapper.builder + binding json.jackson3 d'opensearch-java) ; versions gerees par jackson-bom du parent Boot 4 -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>1.6.3</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>org.kockpit.audit.stream.KockpitStreamApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>kafka</id>
            <dependencies>
                <dependency>
                    <groupId>org.kockpit</groupId>
                    <artifactId>kockpit-audit-stream-starter-kafka</artifactId>
                    <version>1.2.0-SNAPSHOT</version>
                </dependency>
                <dependency>
                    <groupId>org.kockpit</groupId>
                    <artifactId>kockpit-features-audit-starters-kafka</artifactId>
                    <version>1.2.0-SNAPSHOT</version>
                </dependency>
            </dependencies>
            <build>
                <finalName>${project.artifactId}-kafka-${project.version}</finalName>
            </build>
        </profile>
        <profile>
            <id>aws</id>
            <dependencies>
                <dependency>
                    <groupId>org.kockpit</groupId>
                    <artifactId>kockpit-audit-stream-starter-kinesis</artifactId>
                    <version>1.2.0-SNAPSHOT</version>
                </dependency>
                <dependency>
                    <groupId>org.kockpit</groupId>
                    <artifactId>kockpit-features-audit-starters-kinesis</artifactId>
                    <version>1.2.0-SNAPSHOT</version>
                </dependency>
                <dependency>
                    <groupId>org.kockpit</groupId>
                    <artifactId>kockpit-aws-opensearch-request-signing</artifactId>
                    <version>1.2.0-SNAPSHOT</version>
                </dependency>
            </dependencies>
            <build>
                <finalName>${project.artifactId}-aws-${project.version}</finalName>
            </build>
        </profile>
        <profile>
            <!-- Same as "aws", but consumes via Enhanced Fan-Out (real KCL 3.5.1 Scheduler)
                 instead of the polling-based starter. kockpit-features-audit-starters-kinesis
                 (audit notification producer) and kockpit-aws-opensearch-request-signing are
                 unrelated to which consumer mechanism is used, so both profiles need them. -->
            <id>aws-efo</id>
            <dependencies>
                <dependency>
                    <groupId>org.kockpit</groupId>
                    <artifactId>kockpit-audit-stream-starter-kinesis-efo</artifactId>
                    <version>1.2.0-SNAPSHOT</version>
                </dependency>
                <dependency>
                    <groupId>org.kockpit</groupId>
                    <artifactId>kockpit-features-audit-starters-kinesis</artifactId>
                    <version>1.2.0-SNAPSHOT</version>
                </dependency>
                <dependency>
                    <groupId>org.kockpit</groupId>
                    <artifactId>kockpit-aws-opensearch-request-signing</artifactId>
                    <version>1.2.0-SNAPSHOT</version>
                </dependency>
            </dependencies>
            <build>
                <finalName>${project.artifactId}-aws-efo-${project.version}</finalName>
            </build>
        </profile>
    </profiles>
</project>
