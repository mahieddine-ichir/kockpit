{
  "policy": {
    "description": "kockpit-audit-policy-v2: delete after TTL, no rollover (the audit stream rotates indices daily)",
    "ism_template": [
      {
        "index_patterns": ["${index_pattern}"],
        "priority": 200
      }
    ],
    "default_state": "hot",
    "states": [
      {
        "name": "hot",
        "actions": [],
        "transitions": [
          {
            "state_name": "delete",
            "conditions": {
              "min_index_age": "${delete_min_index_age}"
            }
          }
        ]
      },
      {
        "name": "delete",
        "actions": [
          {
            "timeout": "1h",
            "retry": {
              "count": 3,
              "backoff": "exponential",
              "delay": "1m"
            },
            "delete": {}
          }
        ]
      }
    ]
  }
}
