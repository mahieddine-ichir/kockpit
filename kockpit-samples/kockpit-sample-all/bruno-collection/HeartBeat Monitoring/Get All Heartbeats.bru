meta {
  name: Get All Heartbeats
  type: http
  seq: 2
}

get {
  url: {{BASE_URL}}/{{domain}}/{{env}}/heartbeat?active=false
  body: none
  auth: basic
}

params:query {
  active: false
}

auth:basic {
  username: admin
  password: admin
}

docs {
  Get all heartbeat messages for a specific domain and environment
}