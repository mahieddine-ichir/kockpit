	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Set default values for common variables if not already set",
					"if (!pm.collectionVariables.get('BASE_URL')) {",
					"    pm.collectionVariables.set('BASE_URL', 'http://localhost:8080/backend/api');",
					"}",
					"",
					"if (!pm.collectionVariables.get('SAMPLE_BASE_URL')) {",
					"    pm.collectionVariables.set('SAMPLE_BASE_URL', 'http://localhost:8081/sample-app');",
					"}",
					"",
					"if (!pm.collectionVariables.get('domain')) {",
					"    pm.collectionVariables.set('domain', 'sample');",
					"}",
					"",
					"if (!pm.collectionVariables.get('env')) {",
					"    pm.collectionVariables.set('env', 'dev');",
					"}",
					"",
					"if (!pm.collectionVariables.get('auth_token')) {",
					"    // Set a default basic auth token (base64 encoded 'admin:admin')",
					"    pm.collectionVariables.set('auth_token', 'YWRtaW46YWRtaW4=');",
					"}"
				]
			}
		}
